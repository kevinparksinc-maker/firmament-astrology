# Production must use a unique secret of at least 32 characters.
MANUS_JWT_SECRET=

# Optional persistent MySQL-compatible database. Without this, saved data is in-memory only.
DATABASE_URL=

# Optional OAuth/auth integration required for account login.
MANUS_OAUTH_API_URL=
MANUS_PROJECT_ID=
OWNER_OPEN_ID=

# Configure one LLM backend for AI-generated readings.
MANUS_API_URL=
MANUS_API_KEY=
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_BASE=
OPENAI_API_KEY=
GEMINI_API_KEY=

PORT=3000
NODE_ENV=production
